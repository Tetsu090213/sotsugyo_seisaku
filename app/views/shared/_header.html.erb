<header class="bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 transition-colors" data-controller="theme">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center h-16">
      
      <%# ロゴ（サービス名） %>
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "text-lg sm:text-xl font-bold text-slate-800 dark:text-white tracking-tight" do %>
          労働者の心の叫び（仮）
        <% end %>
      </div>

      <%# 右側メニュー（モード切替・認証リンク） %>
      <div class="flex items-center space-x-3 sm:space-x-4">
        
        <%# ライト／ダークモード切替ボタン %>
        <button type="button"
                data-action="click->theme#toggle"
                class="p-2 rounded-lg text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 focus:outline-none"
                aria-label="テーマ切替">
          <%# ダークモード時に表示する太陽アイコン %>
          <svg data-theme-target="sunIcon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
          <%# ライトモード時に表示する月アイコン %>
          <svg data-theme-target="moonIcon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
        </button>

        <%# ログイン・新規登録リンク（Issue #5で実装するまで仮のリンク先 "#" を指定） %>
        <%= link_to "ログイン", "#",
            class: "text-xs font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white whitespace-nowrap" %>
        <%= link_to "新規登録", "#",
            class: "text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-700 px-3 sm:px-4 py-2 rounded-lg transition-colors whitespace-nowrap" %>

      </div>
    </div>
  </div>
</header>
